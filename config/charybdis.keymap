#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// 自定义鼠标移动速度 (默认是 600)

#define ZMK_POINTING_DEFAULT_MOVE_VAL 3000

&lt {
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        lt_space: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SPACE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-unless-interrupted";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp DELETE      &kp N1  &kp N2   &kp N3            &kp N4          &kp N5            &kp N6     &kp N7             &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W    &kp E             &kp R           &kp T             &kp Y      &kp U              &kp I      &kp O    &kp P     &kp BSLH
&kp ESC         &kp A   &lt 4 S  &kp D             &lt 3 F         &kp G             &kp H      &kp J              &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X    &kp C             &kp V           &lt 2 B           &kp N      &kp M              &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                 &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp KP_NUMLOCK    &kp ENTER  &lt_space 5 SPACE
                                                   &kp LEFT_ALT    &mo 1             &mo 1
            >;
        };

        Keyboard_Mouse_Layer {
            bindings = <
&none   &none    &none   &none   &none      &none        &none           &none           &none         &none            &none  &none
&trans  &kp F12  &kp F7  &kp F8  &kp F9     &trans       &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
&trans  &kp F11  &kp F4  &kp F5  &kp F6     &trans       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&trans  &kp F10  &kp F1  &kp F2  &kp F3     &none        &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &none  &trans
                         &trans  &mkp LCLK  &mkp RCLK    &mkp RCLK       &mkp LCLK
                                 &trans     &trans       &mkp MCLK
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans       &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans       &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans       &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans       &trans  &trans     &trans     &trans  &trans  &trans
                        &trans  &trans     &trans       &trans  &trans
                                &mkp LCLK  &mkp RCLK    &trans
            >;
        };

        space_layer {
            bindings = <
&kp INSERT     &none            &none   &none   &none   &none          &none             &none                 &none                  &none              &none         &none
&kp PAGE_UP    &kp GRAVE        &kp N7  &kp N8  &kp N9  &kp HASH       &kp CARET         &kp AMPERSAND         &kp MINUS              &kp EQUAL          &kp ASTERISK  &kp PIPE
&kp PAGE_DOWN  &kp EXCLAMATION  &kp N4  &kp N5  &kp N6  &kp DOLLAR     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp COLON     &kp DOUBLE_QUOTES
&kp HOME       &kp AT_SIGN      &kp N1  &kp N2  &kp N3  &kp PERCENT    &none             &none                 &kp LESS_THAN          &kp GREATER_THAN   &kp QUESTION  &none
                                        &none   &none   &kp N0         &none             &none
                                                &none   &none          &none
            >;
        };
    };
};
